generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hash SHA-256
  name      String
  createdAt DateTime @default(now())
}

model Patient {
  id             String         @id @default(cuid())
  name           String
  cpf            String         @unique
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  contracts      DigitalContract[]
}

model Appointment {
  id                    String            @id @default(cuid())
  patientId             String
  patient               Patient           @relation(fields: [patientId], references: [id])
  consultationType      String            // era enum ConsultationType
  price                 Float
  startsAt              DateTime
  endsAt                DateTime
  durationMinutes       Int
  status                String            @default("agendada") // era enum AppointmentStatus
  summary               String?
  chargeFirstDeposit    Boolean           @default(false)
  recurringWeekly       Boolean           @default(false)
  googleEventId         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  payments              Payment[]
  clinicalNotes         ClinicalNote[]

  @@index([startsAt])
  @@index([status])
}

model ClinicalNote {
  id             String      @id @default(cuid())
  patientId      String
  appointmentId  String?
  patient        Patient     @relation(fields: [patientId], references: [id])
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  content        String
  authorUserId   String
  createdAt      DateTime    @default(now())
}

model Payment {
  id               String        @id @default(cuid())
  appointmentId    String
  appointment      Appointment   @relation(fields: [appointmentId], references: [id])
  amount           Float
  method           String        // era enum PaymentMethod
  status           String        @default("pendente") // era enum PaymentStatus
  isDeposit        Boolean       @default(false)
  isCancellationFee Boolean      @default(false)
  dueAt            DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
}

model AvailabilitySlot {
  id             String   @id @default(cuid())
  startsAt       DateTime
  endsAt         DateTime
  isBlocked      Boolean  @default(false)
  blockReason    String?
  createdAt      DateTime @default(now())
}

model InventoryItem {
  id               String   @id @default(cuid())
  name             String
  quantity         Int
  minQuantityAlert Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DigitalContract {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  provider        String
  externalDocId   String?
  status          String
  signedAt        DateTime?
  createdAt       DateTime @default(now())
}
