PORT=4000
DATABASE_URL="file:./dev.db"

# Obrigatorio em producao; em dev usa fallback se ausente
AUTH_SECRET=sua-chave-secreta-longa-e-aleatoria

# --- Cloudflare R2 (backup na nuvem) ---
# Crie em: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Guia: https://developers.cloudflare.com/r2/api/s3/tokens/

# Opcao A: endpoint completo
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# Opcao B: so o account ID (monta o endpoint automaticamente)
# R2_ACCOUNT_ID=SEU_ACCOUNT_ID

R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=nome-do-bucket

# Nome do arquivo SQLite no bucket (padrao: dev.db)
# R2_DATABASE_KEY=dev.db
